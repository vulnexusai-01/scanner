# Upstash Redis (rate limit + cache distribuídos)
# Copie os valores do painel da Upstash (REST URL e REST Token).
# Use UMA das duas convenções de nome (ambas funcionam):

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Convenção alternativa (nome que a Upstash exibe no console):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# QStash (agendamentos do monitoramento contínuo)
# Copie os valores do painel da Upstash (QStash > Settings).
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# URL pública da aplicação (destino do cron do QStash).
# Na Vercel é preenchido automaticamente por VERCEL_URL; fora dela, defina APP_URL.
APP_URL=

# Opcional: Google Safe Browsing (verificação de reputação/segurança do site).
# Sem a chave, o item "safe-browsing" é omitido do relatório.
GOOGLE_SAFE_BROWSING_KEY=
